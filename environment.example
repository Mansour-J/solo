# ─────────────────────────────────────────────────────────────────────────────
# Development environment template (the development database, Mailpit and
# scripts/api-dev.mjs). Copy to `.env` in the repository root:
#
#     cp environment.example .env
#
# Docker Compose reads `.env` automatically. The desktop app needs none of this. Every variable is documented in
# docs/deployment/environment-variables.md. Never commit `.env`.
# Only VITE_* values reach the browser/desktop bundle: never put secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
# development | production  (production refuses test-only backends)
APP_ENV=development

# ── Branding ─────────────────────────────────────────────────────────────────
# Defaults come from branding/brand.json. Set any of these to rebrand a
# deployment without code changes (rebuild the web image for UI changes:
# `docker compose up -d --build`).
APP_NAME=
APP_SHORT_NAME=
APP_DESCRIPTION=
# Public URL of the app, used for links in emails.
APP_URL=http://localhost:8080
APP_WEBSITE_URL=
APP_SUPPORT_EMAIL=
APP_EMAIL_SENDER_NAME=
APP_EMAIL_FROM=
APP_PRIMARY_COLOR=
APP_SECONDARY_COLOR=
APP_COPYRIGHT=
# Links shown next to the terms checkbox at registration. Set these before going live.
APP_TERMS_URL=
APP_PRIVACY_URL=

# ── Published ports (host side) ──────────────────────────────────────────────
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=solo
# Owner account: used by Flyway migrations and backups only.
POSTGRES_USER=solo_owner
POSTGRES_PASSWORD=change-me-owner-password
# Password of the API's own database role (solo_app), which row-level security applies to.
APP_DB_PASSWORD=change-me-app-password
DATABASE_MAX_CONNECTIONS=10

# ── Email ────────────────────────────────────────────────────────────────────
# smtp | log. The bundled Mailpit catches all mail locally: http://localhost:8025
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# none | starttls | tls
SMTP_TLS=none

# ── File storage (receipts, logos) ───────────────────────────────────────────
# local (Docker volume) | s3 (AWS S3, Cloudflare R2, MinIO, Backblaze B2 …)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Extra origins allowed to call the API (the desktop app's webview in
# development). The Vite dev server proxies /api, so it needs nothing here.
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost
API_MAX_UPLOAD_MB=10
# json | pretty
LOG_FORMAT=json
RUST_LOG=info,sqlx=warn

# ── Clients (build time, public values only) ─────────────────────────────────
# The API `npm run desktop:dev` talks to before its local server is ready.
VITE_API_BASE_URL=http://localhost:8000
